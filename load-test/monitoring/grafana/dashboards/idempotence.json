  "panels": [
    {
      "type": "timeseries",
      "title": "Dup short-circuit rate (per partition)",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "mean"] } },
      "targets": [
        {
          "expr": "rate(kaf_idempotence_dup_total[30s])",
          "legendFormat": "{{topic}}/{{partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Validate errors by code",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum by (error_code) (rate(kaf_idempotence_validate_errors_total[30s]))",
          "legendFormat": "code {{error_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Snapshot writes per minute",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(kaf_producer_snapshot_writes_total[1m]) * 60",
          "legendFormat": "{{topic}}/{{partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "PID blocks leased (cumulative)",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "kaf_pid_blocks_leased_total", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Dups vs Records appended",
      "id": 5,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Idempotent retries silenced. Should be 0 in steady state; non-zero during chaos runs proves dedup works.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(increase(kaf_idempotence_dup_total[15m]))",
          "legendFormat": "dup hits (15m)",
          "refId": "A"
        },
        {
          "expr": "sum(increase(kaf_produce_records_total[15m]))",
          "legendFormat": "records appended (15m)",
          "refId": "B"
        }
      ]
    }
  ],
